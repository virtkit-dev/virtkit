# Images the end-to-end suite boots, pinned by digest. Sourced by tests/gitlab-e2e.sh.
#
# Bumping GitLab: pick the newest `<x.y.z>-ce.0` tag on Docker Hub, then resolve its index
# digest (the multi-arch one; vk picks the host's platform from it):
#
#   repo=gitlab/gitlab-ce tag=19.4.1-ce.0
#   tok=$(curl -fsS "https://auth.docker.io/token?service=registry.docker.io&scope=repository:$repo:pull" | jq -r .token)
#   curl -fsSI -H "Authorization: Bearer $tok" \
#     -H 'Accept: application/vnd.oci.image.index.v1+json, application/vnd.docker.distribution.manifest.list.v2+json' \
#     "https://registry-1.docker.io/v2/$repo/manifests/$tag" | grep -i docker-content-digest
#
# A new digest gets a fresh GitLab state dir (the cache is keyed on it), so the first run
# after a bump is a cold one. The job and service images bump the same way.

# GitLab CE 19.4.1-ce.0
GITLAB_IMAGE=docker.io/gitlab/gitlab-ce@sha256:9b33b45b9f42d176bada85ee5ecb81ddab7e506c435f44cd582206e284b2809c
# alpine/git v2.54.0: the jobs clone in the guest, so their image needs git.
JOB_IMAGE=docker.io/alpine/git@sha256:a4bb51f1a3553df194ce679fc1db721d8bfba2046fa1a88fe9d4ac551ffbce25
# nginx 1.29-alpine, the `services:` scenario's service.
SERVICE_IMAGE=docker.io/library/nginx@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de
